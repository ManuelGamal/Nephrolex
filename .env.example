# Copy to .env and fill in. .env is gitignored and never enters the image.
#
# Generation is optional. With no key the service still answers every question,
# quoting the guideline verbatim with its citation -- the extractive answer is
# the product, and the generated phrasing is an enhancement on top of it that is
# discarded whenever it fails verification.

# One of these, not both. Gemini is the default provider.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Seconds to wait on the model before falling back to evidence-only.
# Measured p50 for generation is ~17 s, so a short cap is hit fairly often by
# design: waiting is worse than showing the guideline text immediately.
# 0 means wait indefinitely -- useful for diagnosing a slow provider, never for a
# live demo.
NEWBIEDUO_GENERATE_TIMEOUT=12
